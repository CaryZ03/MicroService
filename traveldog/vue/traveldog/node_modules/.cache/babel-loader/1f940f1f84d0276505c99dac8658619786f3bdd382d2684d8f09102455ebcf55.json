{"ast":null,"code":"import { Message } from 'element-ui';\nexport default {\n  data() {\n    return {\n      orders: [],\n      dialogVisible: false,\n      selectedOrder: null,\n      rateHotelDialog: false,\n      selectedHotelOrder: '',\n      comment: '',\n      rate: 3,\n      colors: ['#99A9BF', '#F7BA2A', '#FF9900'],\n      confirmRateDialog: false\n    };\n  },\n  methods: {\n    showDetails(order) {\n      this.selectedOrder = order;\n      this.dialogVisible = true;\n    },\n    async getOrders() {\n      await this.axios.post(`/api/user/getUserOrder/${this.uid}`).then(resp => {\n        this.orders = resp.data.content;\n        console.log(\"orders\", this.orders);\n      });\n    },\n    payOrder(order) {\n      const submitForm = {\n        uid: this.uid,\n        oid: order.oid\n      };\n      if (order.status === \"not paid\") {\n        this.axios.post(`/api/user/payOrder`, submitForm).then(resp => {\n          if (resp.data.success) {\n            Message.success(\"付款成功\");\n          } else {\n            Message.error(\"付款失败\");\n          }\n          this.getOrders();\n        });\n      } else {\n        Message.error(\"订单已取消或付款\");\n      }\n    },\n    cancelOrder(order) {\n      const submitForm = {\n        uid: this.uid,\n        oid: order.oid\n      };\n      if (order.status == \"canceled\") {\n        Message.error(\"订单已取消\");\n      } else {\n        this.axios.post(`/api/user/cancelOrder`, submitForm).then(resp => {\n          if (resp.data.success) {\n            Message.success(\"取消订单成功\");\n            this.getOrders();\n          } else {\n            Message.error(\"取消订单失败\");\n          }\n        });\n      }\n    },\n    async deleteOrder(order) {\n      const submitForm = {\n        uid: this.uid,\n        oid: order.oid\n      };\n      await this.axios.post(`/api/user/deleteOrder`, submitForm).then(async resp => {\n        let data = resp.data;\n        if (data.success) {\n          Message.success(\"删除订单成功\");\n          await this.getOrders();\n        } else {\n          Message.error(\"删除订单失败\");\n        }\n      });\n    },\n    rateHotel(order) {\n      this.rateHotelDialog = true;\n      this.selectedHotelOrder = order;\n    },\n    async updateRateHotel(order) {\n      this.rateHotelDialog = true;\n      this.selectedHotelOrder = order;\n      const submitForm = {\n        uid: this.uid,\n        oid: this.selectedHotelOrder.oid,\n        rate: -1,\n        comment: null\n      };\n      await this.axios.put(`/api/user/getHotelComment`, submitForm).then(async resp => {\n        let data = resp.data;\n        if (data.success) {\n          this.rate = data.content.rate;\n          this.comment = data.content.comment;\n          await this.getOrders();\n        } else {\n          Message.error(\"获取前一次评价失败\");\n        }\n      });\n    },\n    async cancelRateHotel(order) {\n      this.selectedHotelOrder = order;\n      const submitForm = {\n        uid: this.uid,\n        oid: this.selectedHotelOrder.oid,\n        rate: -1,\n        comment: null\n      };\n      await this.axios.put(`/api/user/deleteHotelComment`, submitForm).then(async resp => {\n        let data = resp.data;\n        if (data.success) {\n          Message.success(\"删除评价成功\");\n          await this.getOrders();\n        } else {\n          Message.error(\"删除评价失败\");\n        }\n      });\n    },\n    rateHotelCancel() {\n      this.selectedHotelOrder = null;\n      this.rateHotelDialog = false;\n      this.rate = 3;\n      this.comment = null;\n    },\n    rateSubmit() {\n      this.confirmRateDialog = true;\n    },\n    async confirmRateSubmit() {\n      const submitForm = {\n        uid: this.uid,\n        oid: this.selectedHotelOrder.oid,\n        rate: this.rate,\n        comment: this.comment\n      };\n      await this.axios.put(`/api/user/rateHotelByOid`, submitForm).then(resp => {\n        let data = resp.data;\n        if (data.success) {\n          Message.success(\"提交评价成功\");\n          this.confirmRateDialog = false;\n          this.rateHotelDialog = false;\n        } else {\n          Message.error(\"提交评价失败\");\n          this.confirmRateDialog = false;\n          this.rateHotelDialog = false;\n        }\n      });\n      this.rate = null;\n      this.comment = null;\n      await this.getOrders();\n    },\n    confirmRateCancel() {\n      this.confirmRateDialog = false;\n    },\n    formatPrice(price) {\n      return price.toFixed(2);\n    }\n  },\n  //生命周期函数\n  created() {\n    this.uid = sessionStorage.getItem('uid');\n    this.getOrders();\n  }\n};","map":{"version":3,"names":["Message","data","orders","dialogVisible","selectedOrder","rateHotelDialog","selectedHotelOrder","comment","rate","colors","confirmRateDialog","methods","showDetails","order","getOrders","axios","post","uid","then","resp","content","console","log","payOrder","submitForm","oid","status","success","error","cancelOrder","deleteOrder","rateHotel","updateRateHotel","put","cancelRateHotel","rateHotelCancel","rateSubmit","confirmRateSubmit","confirmRateCancel","formatPrice","price","toFixed","created","sessionStorage","getItem"],"sources":["src/views/Usercenter/OrderList/OrderList.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h2>订单列表</h2>\r\n    <el-row :gutter=\"20\" class=\"order-list\">\r\n      <el-col :span=\"8\" v-for=\"(order, index) in orders\" :key=\"order.oid\" class=\"order-col\">\r\n        <el-card :body-style=\"{ padding: '0px' }\" class=\"order-card\">\r\n          <div class=\"card-content\">\r\n            <h3>订单号: {{ order.oid }}</h3>\r\n            <p>价格: ￥{{ formatPrice(order.price) }}</p>\r\n            <p>添加时间: {{ order.addTime }}</p>\r\n            <p>状态: {{ order.status }}</p>\r\n            <p>订单类型: {{ order.type }}</p>\r\n          </div>\r\n          <div class=\"card-footer\">\r\n            <el-button type=\"text\" class=\"button\" @click=\"showDetails(order)\">查看详情</el-button>\r\n            <el-button type=\"text\" class=\"button\"  @click=\"payOrder(order)\" v-if=\"order.status === 'not paid'\">付款</el-button>\r\n            <el-button type=\"text\" class=\"button\"  @click=\"cancelOrder(order)\" v-if=\"order.status === 'not paid' || order.status === 'paid'\">取消订单</el-button>\r\n            <el-button type=\"text\" class=\"button\"  @click=\"deleteOrder(order)\" v-if=\"order.status === 'finished' || order.status === 'canceled'\">删除订单</el-button>\r\n            <el-button type=\"text\" class=\"button\"  @click=\"rateHotel(order)\" v-if=\"(order.status === 'finished' || order.status === 'paid') && order.type === 'hotelOrder' && order.comment === false\">评价酒店</el-button>\r\n            <el-button type=\"text\" class=\"button\"  @click=\"updateRateHotel(order)\" v-if=\"(order.status === 'finished' || order.status === 'paid') && order.type === 'hotelOrder' && order.comment === true\">更新酒店评价</el-button>\r\n            <el-button type=\"text\" class=\"button\"  @click=\"cancelRateHotel(order)\" v-if=\"(order.status === 'finished' || order.status === 'paid') && order.type === 'hotelOrder' && order.comment === true\">取消酒店评价</el-button>\r\n          </div>\r\n        </el-card>\r\n      </el-col>\r\n    </el-row>\r\n    <!--订单信息对话框-->\r\n    <el-dialog :visible.sync=\"dialogVisible\" title=\"订单详情\" width=\"50%\">\r\n      <div v-if=\"selectedOrder\">\r\n        <h3>订单号: {{ selectedOrder.oid }}</h3>\r\n        <p>价格: ￥{{ formatPrice(selectedOrder.price) }}</p>\r\n        <p>添加时间: {{ selectedOrder.addTime }}</p>\r\n        <p>状态: {{ selectedOrder.status }}</p>\r\n        <p>订单类型: {{ selectedOrder.type }}</p>\r\n\r\n        <template v-if=\"selectedOrder.type === 'hotelOrder'\">\r\n          <h4>酒店订单</h4>\r\n          <div v-for=\"(hotelCustomerOrderDemo,index) in selectedOrder.hotelCustomerOrderDemos\" :key=\"index\">\r\n            <p>顾客姓名: {{ hotelCustomerOrderDemo.cname }}</p>\r\n            <p>酒店名称: {{ hotelCustomerOrderDemo.hname }}</p>\r\n            <p>房间号: {{ hotelCustomerOrderDemo.roomNumber }}</p>\r\n            <p>入住时间: {{ hotelCustomerOrderDemo.fromTime }}</p>\r\n            <p>退房时间: {{ hotelCustomerOrderDemo.toTime }}</p>\r\n          </div>\r\n        </template>\r\n\r\n        <template v-if=\"selectedOrder.type === 'trainOrder'\">\r\n          <h4>火车订单</h4>\r\n          <div v-for=\"(trainCustomerOrderDemo,index) in selectedOrder.trainCustomerOrderDemos\" :key=\"index\">\r\n            <p>乘客姓名: {{ trainCustomerOrderDemo.cname }}</p>\r\n            <p>列车编号：{{ trainCustomerOrderDemo.tid }}</p>\r\n            <p>座位号: {{ trainCustomerOrderDemo.seatNumber }}</p>\r\n            <p>座位类型: {{ trainCustomerOrderDemo.seatType }}</p>\r\n            <p>出发时间: {{ trainCustomerOrderDemo.departureTime }}</p>\r\n            <p>到达时间: {{ trainCustomerOrderDemo.arriveTime }}</p>\r\n          </div>\r\n        </template>\r\n\r\n        <template v-if=\"selectedOrder.type === 'mealOrder'\">\r\n          <h4>餐饮订单</h4>\r\n          <div v-for=\"(mealCustomerOrderDemo,index) in selectedOrder.mealCustomerOrderDemos\" :key=\"index\">\r\n            <p>顾客名称：{{ mealCustomerOrderDemo.cname }}</p>\r\n            <p>餐品名称: {{ mealCustomerOrderDemo.mname }}</p>\r\n            <p>所属列车编号：{{ selectedOrder.tid }}</p>\r\n          </div>\r\n        </template>\r\n      </div>\r\n    </el-dialog>\r\n    <!--酒店评价对话框-->\r\n    <el-dialog style=\"width: 100%;height: 100%;\" title=\"为酒店评价\" :visible.sync=\"rateHotelDialog\">\r\n        <div class=\"dialog-body\">\r\n            <el-input v-model=\"comment\" placeholder=\"给出评价\"></el-input>\r\n            <div class=\"block\">\r\n              <span class=\"demonstration\">评价星级</span>\r\n              <el-rate v-model=\"rate\" :colors=\"colors\"></el-rate>\r\n            </div>\r\n        </div>\r\n        <div slot=\"footer\" class=\"dialog-footer\">\r\n            <el-button @click=\"rateHotelCancel()\">取 消</el-button>\r\n            <el-button type=\"primary\" @click=\"rateSubmit()\">确 定</el-button>\r\n        </div>\r\n    </el-dialog>\r\n    <!--确认评价框-->\r\n    <el-dialog style=\"width: 100%;height: 100%;\" title=\"确认提交吗？\" :visible.sync=\"confirmRateDialog\">\r\n        <div class=\"dialog-body\">\r\n          <span>确认提交后将无法修改评价，并且删除订单将删除你的评论</span>\r\n        </div>\r\n        <div slot=\"footer\" class=\"dialog-footer\">\r\n            <el-button @click=\"confirmRateCancel()\">取 消</el-button>\r\n            <el-button type=\"primary\" @click=\"confirmRateSubmit()\">确 定</el-button>\r\n        </div>\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n  \r\n  <script>\r\nimport { Message } from 'element-ui';\r\n\r\n  export default {\r\n    data() {\r\n      return {\r\n        orders: [],\r\n        dialogVisible: false,\r\n        selectedOrder: null,\r\n        rateHotelDialog: false,\r\n        selectedHotelOrder: '',\r\n        comment: '',\r\n        rate: 3,\r\n        colors: ['#99A9BF', '#F7BA2A', '#FF9900'],\r\n        confirmRateDialog: false\r\n      };\r\n    },\r\n    methods: {\r\n      showDetails(order) {\r\n        this.selectedOrder = order;\r\n        this.dialogVisible = true;\r\n      },\r\n      async getOrders(){\r\n        await this.axios.post(`/api/user/getUserOrder/${this.uid}`).then((resp) => {\r\n            this.orders = resp.data.content;\r\n            console.log(\"orders\",this.orders);\r\n        });\r\n      },\r\n      payOrder(order){\r\n        const submitForm = {\r\n          uid:this.uid,\r\n          oid:order.oid\r\n        }\r\n        if(order.status === \"not paid\"){\r\n          this.axios.post(`/api/user/payOrder`,submitForm).then((resp) => {\r\n            if(resp.data.success){\r\n              Message.success(\"付款成功\");\r\n            }else{\r\n              Message.error(\"付款失败\");\r\n            }\r\n            this.getOrders();\r\n          }); \r\n        }else{\r\n          Message.error(\"订单已取消或付款\");\r\n        }\r\n      },\r\n      cancelOrder(order){\r\n        const submitForm = {\r\n          uid:this.uid,\r\n          oid:order.oid\r\n        };\r\n        if(order.status == \"canceled\"){\r\n          Message.error(\"订单已取消\");\r\n        }else{\r\n          this.axios.post(`/api/user/cancelOrder`,submitForm).then((resp) => {\r\n            if(resp.data.success){\r\n              Message.success(\"取消订单成功\");\r\n              this.getOrders();\r\n            }else{\r\n              Message.error(\"取消订单失败\");\r\n            }\r\n          });\r\n        }\r\n      },\r\n      async deleteOrder(order){\r\n        const submitForm={\r\n          uid: this.uid,\r\n          oid: order.oid\r\n        }\r\n        await this.axios.post(`/api/user/deleteOrder`,submitForm).then(async (resp) => {\r\n          let data = resp.data;\r\n          if(data.success){\r\n            Message.success(\"删除订单成功\");\r\n            await this.getOrders();\r\n          }else{\r\n            Message.error(\"删除订单失败\");\r\n          }\r\n        })\r\n      },\r\n      rateHotel(order){\r\n        this.rateHotelDialog = true;\r\n        this.selectedHotelOrder = order;\r\n      },\r\n      async updateRateHotel(order){\r\n        this.rateHotelDialog = true;\r\n        this.selectedHotelOrder = order;\r\n        const submitForm={\r\n          uid: this.uid,\r\n          oid: this.selectedHotelOrder.oid,\r\n          rate: -1,\r\n          comment: null\r\n        }\r\n        await this.axios.put(`/api/user/getHotelComment`,submitForm).then(async (resp) => {\r\n          let data = resp.data;\r\n          if(data.success){\r\n            this.rate=data.content.rate;\r\n            this.comment=data.content.comment;\r\n            await this.getOrders();\r\n          }else{\r\n            Message.error(\"获取前一次评价失败\");\r\n          }\r\n        });\r\n      },\r\n      async cancelRateHotel(order){\r\n        this.selectedHotelOrder = order;\r\n        const submitForm={\r\n          uid: this.uid,\r\n          oid: this.selectedHotelOrder.oid,\r\n          rate: -1,\r\n          comment: null\r\n        }\r\n        await this.axios.put(`/api/user/deleteHotelComment`,submitForm).then(async (resp) => {\r\n          let data = resp.data;\r\n          if(data.success){\r\n            Message.success(\"删除评价成功\");\r\n            await this.getOrders();\r\n          }else{\r\n            Message.error(\"删除评价失败\");\r\n          }\r\n        });\r\n      },\r\n      rateHotelCancel(){\r\n        this.selectedHotelOrder=null;\r\n        this.rateHotelDialog=false;\r\n        this.rate=3;\r\n        this.comment=null;\r\n      },\r\n      rateSubmit(){\r\n        this.confirmRateDialog=true;\r\n      },\r\n      async confirmRateSubmit(){\r\n        const submitForm={\r\n          uid: this.uid,\r\n          oid: this.selectedHotelOrder.oid,\r\n          rate: this.rate,\r\n          comment: this.comment\r\n        }\r\n        await this.axios.put(`/api/user/rateHotelByOid`,submitForm).then((resp) => {\r\n          let data = resp.data;\r\n          if(data.success){\r\n            Message.success(\"提交评价成功\");\r\n            this.confirmRateDialog=false;\r\n            this.rateHotelDialog=false;\r\n          }else{\r\n            Message.error(\"提交评价失败\");\r\n            this.confirmRateDialog=false;\r\n            this.rateHotelDialog=false;\r\n          }\r\n        });\r\n        this.rate=null;\r\n        this.comment=null;\r\n        await this.getOrders();\r\n      },\r\n      confirmRateCancel(){\r\n        this.confirmRateDialog=false;\r\n      },\r\n      formatPrice(price) {\r\n          return price.toFixed(2);\r\n      },\r\n    },\r\n    //生命周期函数\r\n    created() {\r\n        this.uid=sessionStorage.getItem('uid');\r\n        this.getOrders();\r\n    }\r\n  };\r\n  </script>\r\n  \r\n  <style>\r\n.order-list {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.order-col {\r\n  display: flex;\r\n  flex: 0 0 33.3333%; /* Adjust this value if you want different sizing */\r\n  max-width: 33.3333%; /* Adjust this value if you want different sizing */\r\n  box-sizing: border-box;\r\n}\r\n\r\n.order-card {\r\n  width: 100%;\r\n}\r\n  </style>"],"mappings":"AA+FA,SAAAA,OAAA;AAEA;EACAC,KAAA;IACA;MACAC,MAAA;MACAC,aAAA;MACAC,aAAA;MACAC,eAAA;MACAC,kBAAA;MACAC,OAAA;MACAC,IAAA;MACAC,MAAA;MACAC,iBAAA;IACA;EACA;EACAC,OAAA;IACAC,YAAAC,KAAA;MACA,KAAAT,aAAA,GAAAS,KAAA;MACA,KAAAV,aAAA;IACA;IACA,MAAAW,UAAA;MACA,WAAAC,KAAA,CAAAC,IAAA,gCAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA;QACA,KAAAjB,MAAA,GAAAiB,IAAA,CAAAlB,IAAA,CAAAmB,OAAA;QACAC,OAAA,CAAAC,GAAA,gBAAApB,MAAA;MACA;IACA;IACAqB,SAAAV,KAAA;MACA,MAAAW,UAAA;QACAP,GAAA,OAAAA,GAAA;QACAQ,GAAA,EAAAZ,KAAA,CAAAY;MACA;MACA,IAAAZ,KAAA,CAAAa,MAAA;QACA,KAAAX,KAAA,CAAAC,IAAA,uBAAAQ,UAAA,EAAAN,IAAA,CAAAC,IAAA;UACA,IAAAA,IAAA,CAAAlB,IAAA,CAAA0B,OAAA;YACA3B,OAAA,CAAA2B,OAAA;UACA;YACA3B,OAAA,CAAA4B,KAAA;UACA;UACA,KAAAd,SAAA;QACA;MACA;QACAd,OAAA,CAAA4B,KAAA;MACA;IACA;IACAC,YAAAhB,KAAA;MACA,MAAAW,UAAA;QACAP,GAAA,OAAAA,GAAA;QACAQ,GAAA,EAAAZ,KAAA,CAAAY;MACA;MACA,IAAAZ,KAAA,CAAAa,MAAA;QACA1B,OAAA,CAAA4B,KAAA;MACA;QACA,KAAAb,KAAA,CAAAC,IAAA,0BAAAQ,UAAA,EAAAN,IAAA,CAAAC,IAAA;UACA,IAAAA,IAAA,CAAAlB,IAAA,CAAA0B,OAAA;YACA3B,OAAA,CAAA2B,OAAA;YACA,KAAAb,SAAA;UACA;YACAd,OAAA,CAAA4B,KAAA;UACA;QACA;MACA;IACA;IACA,MAAAE,YAAAjB,KAAA;MACA,MAAAW,UAAA;QACAP,GAAA,OAAAA,GAAA;QACAQ,GAAA,EAAAZ,KAAA,CAAAY;MACA;MACA,WAAAV,KAAA,CAAAC,IAAA,0BAAAQ,UAAA,EAAAN,IAAA,OAAAC,IAAA;QACA,IAAAlB,IAAA,GAAAkB,IAAA,CAAAlB,IAAA;QACA,IAAAA,IAAA,CAAA0B,OAAA;UACA3B,OAAA,CAAA2B,OAAA;UACA,WAAAb,SAAA;QACA;UACAd,OAAA,CAAA4B,KAAA;QACA;MACA;IACA;IACAG,UAAAlB,KAAA;MACA,KAAAR,eAAA;MACA,KAAAC,kBAAA,GAAAO,KAAA;IACA;IACA,MAAAmB,gBAAAnB,KAAA;MACA,KAAAR,eAAA;MACA,KAAAC,kBAAA,GAAAO,KAAA;MACA,MAAAW,UAAA;QACAP,GAAA,OAAAA,GAAA;QACAQ,GAAA,OAAAnB,kBAAA,CAAAmB,GAAA;QACAjB,IAAA;QACAD,OAAA;MACA;MACA,WAAAQ,KAAA,CAAAkB,GAAA,8BAAAT,UAAA,EAAAN,IAAA,OAAAC,IAAA;QACA,IAAAlB,IAAA,GAAAkB,IAAA,CAAAlB,IAAA;QACA,IAAAA,IAAA,CAAA0B,OAAA;UACA,KAAAnB,IAAA,GAAAP,IAAA,CAAAmB,OAAA,CAAAZ,IAAA;UACA,KAAAD,OAAA,GAAAN,IAAA,CAAAmB,OAAA,CAAAb,OAAA;UACA,WAAAO,SAAA;QACA;UACAd,OAAA,CAAA4B,KAAA;QACA;MACA;IACA;IACA,MAAAM,gBAAArB,KAAA;MACA,