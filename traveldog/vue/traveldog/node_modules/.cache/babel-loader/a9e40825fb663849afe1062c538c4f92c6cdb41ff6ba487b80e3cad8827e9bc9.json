{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: 'Login',\n  data() {\n    return {\n      loginForm: {\n        uid: '',\n        password: ''\n      }\n    };\n  },\n  methods: {\n    Login() {\n      this.$emit('update-uid', this.loginForm.u_id);\n      this.axios.post('/api/login', this.loginForm).then(resp => {\n        let data = resp.data;\n        if (data.success) {\n          //成功\n          this.$message({\n            showClose: true,\n            message: '成功登录',\n            type: 'success'\n          });\n          sessionStorage.setItem('uid', data.content.id);\n          sessionStorage.setItem('password', this.loginForm.password);\n          this.$router.push({\n            path: '/home'\n          });\n          this.loginForm = {}; //置空\n        } else {\n          this.loginForm = {}; //置空\n          this.$message({\n            showClose: true,\n            message: data.message,\n            type: 'error'\n          });\n        }\n      });\n    },\n    toregister() {\n      this.$router.push({\n        path: '/register'\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","data","loginForm","uid","password","methods","Login","$emit","u_id","axios","post","then","resp","success","$message","showClose","message","type","sessionStorage","setItem","content","id","$router","push","path","toregister"],"sources":["src/views/Login.vue"],"sourcesContent":["<template>\r\n    <body id=\"poster\">\r\n        <el-form class=\"login-container\" label-position=\"left\" label-width=\"0px\">\r\n            <h3 class=\"login_title\">\r\n                系统登录\r\n                <el-button @click=\"toregister()\">点我注册</el-button>\r\n            </h3>\r\n            <el-form-item label=\"\">\r\n                <el-input type=\"text\" v-model=\"loginForm.uid\" autocomplete=\"off\" placeholder=\"账号\"></el-input>\r\n            </el-form-item>\r\n            <el-form-item label=\"\">\r\n                <el-input type=\"password\" v-model=\"loginForm.password\" autocomplete=\"off\" placeholder=\"密码\"></el-input>\r\n            </el-form-item>\r\n            <el-form-item>\r\n                <el-button type=\"primary\" style=\"width:100%; background: #505458;border: none;\" @click=\"Login()\">登录</el-button>\r\n            </el-form-item>\r\n        </el-form>\r\n    </body>\r\n  </template>\r\n  \r\n  <script>\r\n  export default {\r\n    name: 'Login',\r\n    data() {\r\n      return {\r\n        loginForm: {\r\n          uid: '',\r\n          password: ''\r\n        }\r\n      }\r\n    },\r\n    methods: {\r\n      Login() {\r\n        this.$emit('update-uid', this.loginForm.u_id);  \r\n        this.axios.post('/api/login',this.loginForm).then((resp) =>{\r\n            let data = resp.data;\r\n            if(data.success){   //成功\r\n                this.$message({\r\n                    showClose: true,\r\n                    message: '成功登录',\r\n                    type: 'success'\r\n                });\r\n                sessionStorage.setItem('uid', data.content.id);\r\n                sessionStorage.setItem('password',this.loginForm.password);\r\n                this.$router.push({path:'/home'})\r\n                this.loginForm = {};    //置空\r\n            }else{\r\n                this.loginForm = {};    //置空\r\n                this.$message({\r\n                    showClose: true,\r\n                    message: data.message,\r\n                    type: 'error'\r\n                });\r\n            }\r\n        })\r\n      } ,\r\n      toregister(){\r\n        this.$router.push({path:'/register'})\r\n      }\r\n    }\r\n  }\r\n  </script>\r\n  \r\n<style>\r\n    #poster{\r\n        background-position: center;\r\n        height:100%;\r\n        width: 100%;\r\n        background-size: cover;\r\n        position: fixed;\r\n    }\r\n    body{\r\n        margin: 0px;\r\n        padding:0px;\r\n    }\r\n    .login-container{\r\n        border-radius: 15px;\r\n        back