{"ast":null,"code":"export default {\n  props: ['isCollapse', 'drawer'],\n  methods: {\n    changeMenu() {\n      //点击切换按钮时，修改父组件platform的数据isCollapse\n      this.$emit('changeCollapse');\n    },\n    changeDrawer() {\n      console.log(\"changDrawer active\");\n      this.$emit('changeDrawer');\n    }\n  }\n};","map":{"version":3,"names":["props","methods","changeMenu","$emit","changeDrawer","console","log"],"sources":["src/views/Content.vue"],"sourcesContent":["<template>\r\n    <div>\r\n        <div class=\"header\">\r\n            <i v-if=\"!isCollapse\" @click=\"changeMenu\" class=\"el-icon-s-fold\"></i>\r\n            <i v-else @click=\"changeMenu\" class=\"el-icon-s-unfold\"></i>\r\n            <i @click=\"changeDrawer\" class=\"el-icon-message-solid\"></i>\r\n        </div>\r\n            \r\n        <!--内容区域---路由出口-->\r\n        <div class=\"content\">\r\n            <router-view/>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n    props:['isCollapse','drawer'],\r\n    methods:{\r\n        changeMenu(){\r\n            //点击切换按钮时，修改父组件platform的数据isCollapse\r\n            this.$emit('changeCollapse')\r\n        },\r\n        changeDrawer(){\r\n            console.log(\"changDrawer active\");\r\n            this.$emit('changeDrawer');\r\n        }\r\n    }\r\n}\r\n</script>\r\n\r\n<style lang=\"less\" scoped>\r\n.header{\r\n    height: 50px;\r\n    line-height: 50px;\r\n    color: #fff;\r\n    background: skyblue;\r\n    text-align: left;\r\n    .el-icon-s-fold{   \r\n        font-size: 24px;\r\n    }\r\n    .el-icon-s-unfold{\r\n        font-size: 24px;\r\n    }\r\n    .el-icon-message-solid{\r\n        font-size: 30px;\r\n        margin-top: 10px;\r\n        float: right;\r\n    }\r\n}\r\n\r\n</style>"],"mappings":"AAgBA;EACAA,KAAA;EACAC,OAAA;IACAC,WAAA;MACA;MACA,KAAAC,KAAA;IACA;IACAC,aAAA;MACAC,OAAA,CAAAC,GAAA;MACA,KAAAH,KAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}