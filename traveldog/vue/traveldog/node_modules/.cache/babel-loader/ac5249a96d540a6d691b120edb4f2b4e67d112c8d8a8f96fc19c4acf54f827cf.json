ot-name, .sptt-name {  \r\n  font-weight: bold;  \r\n}  \r\n  \r\n.spot-price, .sptt-price {  \r\n  font-size: 1rem; /* 使用相对单位 */  \r\n  color: red;  \r\n}  \r\n\r\n.swiper {\r\n      height: 350px;\r\n      width: 1400px;\r\n      position: relative;\r\n      overflow: hidden;\r\n      margin: 10px ;\r\n      border: 10px solid royalblue;\r\n      border-radius: 20px;\r\n      box-shadow: 15px 15px 20px 4px rgba(5, 131, 148, 0.5);\r\n    }\r\n    .swiper-content {\r\n      position: absolute;\r\n      left: 0;\r\n      display: flex;\r\n    }\r\n    \r\n    .swiper-item {\r\n      height: 350px;\r\n      width: 1400px;\r\n    }\r\n    \r\n    img {\r\n      height: 100%;\r\n      width: 100%;\r\n    }\r\n    \r\n    span {\r\n  display: inline-block;\r\n  height: 12px;\r\n  width: 12px;\r\n  background-color: orange;\r\n  margin-left: 50px;\r\n  border-radius: 200px;\r\n  cursor: pointer;\r\n}\r\n    .page {\r\n      position: absolute;\r\n      left: 50%;\r\n      transform: translate(-50%, -50%);\r\n      bottom: 5px;\r\n    }\r\n    .footer-text {\r\n  margin: 0; \r\n  padding: 0;\r\n}\r\n\r\n</style>\r\n"],"mappings":"AAkGA,SAAAA,MAAA;AACA;EACAC,KAAA;IACA;MACAC,QAAA,GACAC,OAAA,aACAA,OAAA,aACAA,OAAA;IAGA;EACA;EACAC,OAAA;IACAC,OAAA;MACA,IAAAL,MAAA;QACAM,OAAA;QACAC,UAAA;QACAC,IAAA;MACA;IACA;EACA;EAEAC,QAAA;IACA,KAAAJ,MAAA;EACA;AAGA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}