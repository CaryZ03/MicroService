{"ast":null,"code":"export default {\n  name: 'App',\n  data() {\n    return {\n      gap_time: 0,\n      beforeUnload_time: 0,\n      loginForm: {\n        uid: '',\n        password: ''\n      }\n    };\n  },\n  methods: {\n    // 关闭窗口之前执行\n    beforeunloadHandler() {\n      this.beforeUnload_time = new Date().getTime();\n    },\n    unloadHandler() {\n      this.gap_time = new Date().getTime() - this.beforeUnload_time;\n      //判断是窗口关闭还是刷新 毫秒数判断 网上大部分写的是5\n      if (this.gap_time <= 10) {\n        this.loginForm.uid = localStorage.getItem('uid');\n        this.axios.post('/api/logout', this.loginForm);\n      }\n    }\n  },\n  destroyed() {\n    // 移除监听\n    window.removeEventListener(\"beforeunload\", () => this.beforeunloadHandler());\n    window.removeEventListener(\"unload\", () => this.unloadHandler());\n  },\n  mounted() {\n    // 监听浏览器关闭\n    window.addEventListener(\"beforeunload\", () => this.beforeunloadHandler());\n    window.addEventListener(\"unload\", () => this.unloadHandler());\n  }\n};","map":{"version":3,"names":["name","data","gap_time","beforeUnload_time","loginForm","uid","password","methods","beforeunloadHandler","Date","getTime","unloadHandler","localStorage","getItem","axios","post","destroyed","window","removeEventListener","mounted","addEventListener"],"sources":["src/App.vue"],"sourcesContent":["<template>\r\n  <div id=\"app\">\r\n    <router-view/>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n\r\nexport default {\r\n  name: 'App',\r\n  data() {\r\n    return {\r\n      gap_time: 0,\r\n      beforeUnload_time: 0,\r\n      loginForm: {\r\n          uid: '',\r\n          password: ''\r\n        }\r\n    };\r\n  },\r\n  methods: {\r\n    // 关闭窗口之前执行\r\n    beforeunloadHandler() {\r\n      this.beforeUnload_time = new Date().getTime();\r\n    },\r\n    unloadHandler() {\r\n      this.gap_time = new Date().getTime() - this.beforeUnload_time;\r\n      //判断是窗口关闭还是刷新 毫秒数判断 网上大部分写的是5\r\n      if (this.gap_time <= 10) {\r\n        this.loginForm.uid = localStorage.getItem('uid')\r\n        this.axios.post('/api/logout',this.loginForm)\r\n      }\r\n    },\r\n  },\r\n  destroyed() {\r\n    // 移除监听\r\n    window.removeEventListener(\"beforeunload\", () => this.beforeunloadHandler());\r\n    window.removeEventListener(\"unload\", () => this.unloadHandler());\r\n  },\r\n  mounted() {\r\n    // 监听浏览器关闭\r\n    window.addEventListener(\"beforeunload\", () => this.beforeunloadHandler());\r\n    window.addEventListener(\"unload\", () => this.unloadHandler());\r\n  }\r\n};\r\n</script>\r\n\r\n<style lang=\"less\">\r\n#app {\r\n  font-family: Avenir, Helvetica, Arial, sans-serif;\r\n  -webkit-font-smoothing: antialiased;\r\n  -moz-osx-font-smoothing: grayscale;\r\n  text-align: center;\r\n  color: #2c3e50;\r\n}\r\n\r\nnav {\r\n  padding: 30px;\r\n\r\n  a {\r\n    font-weight: bold;\r\n    color: #2c3e50;\r\n\r\n    &.router-link-exact-active {\r\n      color: #42b983;\r\n    }\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AAQA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,QAAA;MACAC,iBAAA;MACAC,SAAA;QACAC,GAAA;QACAC,QAAA;MACA;IACA;EACA;EACAC,OAAA;IACA;IACAC,oBAAA;MACA,KAAAL,iBAAA,OAAAM,IAAA,GAAAC,OAAA;IACA;IACAC,cAAA;MACA,KAAAT,QAAA,OAAAO,IAAA,GAAAC,OAAA,UAAAP,iBAAA;MACA;MACA,SAAAD,QAAA;QACA,KAAAE,SAAA,CAAAC,GAAA,GAAAO,YAAA,CAAAC,OAAA;QACA,KAAAC,KAAA,CAAAC,IAAA,qBAAAX,SAAA;MACA;IACA;EACA;EACAY,UAAA;IACA;IACAC,MAAA,CAAAC,mBAAA,4BAAAV,mBAAA;IACAS,MAAA,CAAAC,mBAAA,sBAAAP,aAAA;EACA;EACAQ,QAAA;IACA;IACAF,MAAA,CAAAG,gBAAA,4BAAAZ,mBAAA;IACAS,MAAA,CAAAG,gBAAA,sBAAAT,aAAA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}